{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "implementer": {
      "description": "GamerBooker implementer. Writes application source and tests for one approved ENG-* task. Reads docs/ as the spec but can never modify it. No git, no network, no installs, no secret reads.",
      "mode": "subagent",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },

        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*secret*", "effect": "deny" },
        { "action": "read", "resource": "*.pem", "effect": "deny" },
        { "action": "read", "resource": "*.key", "effect": "deny" },
        { "action": "read", "resource": ".git/*", "effect": "deny" },

        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "src/*", "effect": "allow" },
        { "action": "edit", "resource": "tests/*", "effect": "allow" },
        { "action": "edit", "resource": "prisma/*", "effect": "allow" },
        { "action": "edit", "resource": "migrations/*", "effect": "allow" },
        { "action": "edit", "resource": "db/*", "effect": "allow" },
        { "action": "edit", "resource": "package.json", "effect": "allow" },
        { "action": "edit", "resource": "tsconfig*", "effect": "allow" },
        { "action": "edit", "resource": "*.config.js", "effect": "allow" },
        { "action": "edit", "resource": "*.config.ts", "effect": "allow" },
        { "action": "edit", "resource": "*.config.mjs", "effect": "allow" },
        { "action": "edit", "resource": ".eslintrc*", "effect": "allow" },
        { "action": "edit", "resource": "nest-cli.json", "effect": "allow" },
        { "action": "edit", "resource": ".github/*", "effect": "allow" },
        { "action": "edit", "resource": "docker/*", "effect": "allow" },
        { "action": "edit", "resource": "Dockerfile*", "effect": "allow" },
        { "action": "edit", "resource": "docker-compose*", "effect": "allow" },
        { "action": "edit", "resource": "README.md", "effect": "allow" },

        { "action": "edit", "resource": "docs/*", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/*", "effect": "deny" },
        { "action": "edit", "resource": "opencode.json*", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": ".env.example", "effect": "allow" },
        { "action": "edit", "resource": ".git/*", "effect": "deny" },
        { "action": "edit", "resource": "*.pem", "effect": "deny" },
        { "action": "edit", "resource": "*.key", "effect": "deny" },

        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "npm test *", "effect": "allow" },
        { "action": "shell", "resource": "npm run build *", "effect": "allow" },
        { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
        { "action": "shell", "resource": "npm run typecheck *", "effect": "allow" },
        { "action": "shell", "resource": "npm run test *", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc *", "effect": "allow" },
        { "action": "shell", "resource": "npx prisma *", "effect": "allow" },
        { "action": "shell", "resource": "npx jest *", "effect": "allow" },
        { "action": "shell", "resource": "npx vitest *", "effect": "allow" },
        { "action": "shell", "resource": "node --test *", "effect": "allow" },

        { "action": "shell", "resource": "npm install *", "effect": "deny" },
        { "action": "shell", "resource": "npm i *", "effect": "deny" },
        { "action": "shell", "resource": "npm ci *", "effect": "deny" },
        { "action": "shell", "resource": "pnpm *", "effect": "deny" },
        { "action": "shell", "resource": "yarn *", "effect": "deny" },
        { "action": "shell", "resource": "npx *", "effect": "deny" },
        { "action": "shell", "resource": "git *", "effect": "deny" },
        { "action": "shell", "resource": "curl *", "effect": "deny" },
        { "action": "shell", "resource": "wget *", "effect": "deny" },
        { "action": "shell", "resource": "Invoke-*", "effect": "deny" },
        { "action": "shell", "resource": "irm *", "effect": "deny" },
        { "action": "shell", "resource": "iwr *", "effect": "deny" },
        { "action": "shell", "resource": "iex *", "effect": "deny" },
        { "action": "shell", "resource": "rm *", "effect": "deny" },
        { "action": "shell", "resource": "del *", "effect": "deny" },
        { "action": "shell", "resource": "Remove-Item *", "effect": "deny" },
        { "action": "shell", "resource": "rd *", "effect": "deny" },
        { "action": "shell", "resource": "mv *", "effect": "deny" },
        { "action": "shell", "resource": "Move-Item *", "effect": "deny" },
        { "action": "shell", "resource": "psql *", "effect": "deny" },
        { "action": "shell", "resource": "pg_dump *", "effect": "deny" },

        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    },
    "tester": {
      "description": "GamerBooker tester. Writes and runs automated tests that prove P0 cases T-001..T-030. Owns tests/ only.",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "tests/**", "effect": "allow" },
        { "action": "edit", "resource": "docs/**", "effect": "deny" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "prisma/**", "effect": "deny" },
        { "action": "edit", "resource": "migrations/**", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "opencode.json*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "npm test*", "effect": "allow" },
        { "action": "shell", "resource": "npm run test*", "effect": "allow" },
        { "action": "shell", "resource": "npx jest*", "effect": "allow" },
        { "action": "shell", "resource": "npm run typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc*", "effect": "allow" },
        { "action": "shell", "resource": "git *", "effect": "deny" },
        { "action": "shell", "resource": "npm install *", "effect": "deny" },
        { "action": "shell", "resource": "npx prisma *", "effect": "deny" },
        { "action": "shell", "resource": "rm *", "effect": "deny" },
        { "action": "shell", "resource": "Remove-Item *", "effect": "deny" },
        { "action": "shell", "resource": "curl *", "effect": "deny" },
        { "action": "shell", "resource": "Invoke-*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "scribe": {
      "description": "GamerBooker scribe. Maintains CHANGELOG, ADRs, handoff packets and decision logs. Owns project records only.",
      "mode": "subagent",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "CHANGELOG.md", "effect": "allow" },
        { "action": "edit", "resource": "adr/**", "effect": "allow" },
        { "action": "edit", "resource": "handoff/**", "effect": "allow" },
        { "action": "edit", "resource": "notes/**", "effect": "allow" },
        { "action": "edit", "resource": "docs/**", "effect": "deny" },
        { "action": "edit", "resource": "src/**", "effect": "deny" },
        { "action": "edit", "resource": "tests/**", "effect": "deny" },
        { "action": "edit", "resource": "prisma/**", "effect": "deny" },
        { "action": "edit", "resource": "migrations/**", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
        { "action": "edit", "resource": "opencode.json*", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*.pem", "effect": "deny" },
        { "action": "edit", "resource": "*.key", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "reviewer": {
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },

        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*secret*", "effect": "deny" },
        { "action": "read", "resource": "*.pem", "effect": "deny" },
        { "action": "read", "resource": "*.key", "effect": "deny" },

        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
