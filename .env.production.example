# ==============================================================================
# GamerBooker Enterprise v1.0 — Production Environment Variables Template
# Copy this file to .env on your production VPS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 16 PRODUCTION DATABASE
# Must support btree_gist extension (included in default postgres image)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_strong_64_char_password_here
POSTGRES_DB=gamerbooker_prod
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. REDIS 7 IN-MEMORY CACHE & LOCK BROKER
# ------------------------------------------------------------------------------
REDIS_PASSWORD=generate_another_strong_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ------------------------------------------------------------------------------
# 4. SECURITY & CRYPTOGRAPHY SECRETS
# ------------------------------------------------------------------------------
# Secret for HMAC-SHA256 session and MFA TOTP tokens (min 32 characters)
MFA_SECRET_KEY=replace_with_min_32_characters_random_hex_string_0123456789

# Secret for signing turnstile HMAC rolling QR codes
QR_SIGNING_SECRET=replace_with_secure_qr_turnstile_secret_key_9876543210

# ------------------------------------------------------------------------------
# 5. PAYMENT PROCESSOR (PSP) CREDENTIALS
# Obtain from https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------------------------
# Leave empty for local sandbox mode; populate with live keys for real revenue
STRIPE_SECRET_KEY=sk_live_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_signing_secret

# ------------------------------------------------------------------------------
# 6. SMS GATEWAY PROVIDER (OTP & TURNSTILE ALERTS)
# Choose either Twilio or SMSLink.ro for Romanian phone numbers (+40)
# ------------------------------------------------------------------------------
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Or SMSLink.ro (Romanian native provider)
SMSLINK_CONNECTION_ID=
SMSLINK_PASSWORD=

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL (ANAF FISCAL RECEIPTS & NOTIFICATIONS)
# Obtain from https://resend.com or AWS SES
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=GamerBooker Arena <confirmations@gamerbooker.ro>

# ------------------------------------------------------------------------------
# 8. DOMAINS & CORS ALLOWED ORIGINS
# ------------------------------------------------------------------------------
APP_DOMAIN=gamerbooker.ro
API_URL=https://api.gamerbooker.ro
DASHBOARD_URL=https://dashboard.gamerbooker.ro
MOBILE_URL=https://app.gamerbooker.ro
CORS_ORIGINS=https://gamerbooker.ro,https://app.gamerbooker.ro,https://dashboard.gamerbooker.ro
