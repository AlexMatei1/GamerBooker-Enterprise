# Normalize to LF in the repository so docs and source are byte-stable across machines.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Preserve Windows scripts if any are added later
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
